{
  "name": "research-assistant",
  "version": "0.1.0",
  "description": "Event-driven desktop research assistant",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "biome lint ./src ./e2e",
    "format": "biome format --write ./src",
    "check": "biome check --write --no-errors-on-unmatched ./src ./e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:eval": "bun tests/eval/harness.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "bun run build",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.59.1",
    "@swc/core": "^1.15.26",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.2.1",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@langfuse/otel": "^5.3.0",
    "@langfuse/tracing": "^5.3.0",
    "@libsql/client": "^0.17.2",
    "@mariozechner/pi-agent-core": "^0.67.68",
    "@mariozechner/pi-ai": "^0.67.68",
    "@mastra/libsql": "^1.9.0",
    "@mastra/memory": "^1.17.5",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "chokidar": "^5.0.0",
    "dockerode": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "tsyringe": "^4.10.0",
    "yaml": "^2.8.3",
    "zod": "^4.4.2"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
